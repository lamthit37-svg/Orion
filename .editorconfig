# Quy ước chung cho mọi editor. Định dạng C++ do .clang-format quyết; file này chỉ lo phần còn lại
# và phải khớp những gì tools/check_style.py kiểm.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.md]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
